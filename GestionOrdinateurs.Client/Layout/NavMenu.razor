@inject JwtAuthenticationStateProvider Auth
@inject NavigationManager Navigation

<div class="p-3 text-white"><strong>Atelier informatique</strong></div>
<nav class="nav flex-column">
    <div class="nav-item px-3"><NavLink class="nav-link" href="" Match="NavLinkMatch.All">Accueil</NavLink></div>
    <AuthorizeView>
        <Authorized>
            <div class="nav-item px-3"><NavLink class="nav-link" href="ordinateurs">Ordinateurs</NavLink></div>
            <div class="nav-item px-3"><NavLink class="nav-link" href="reparations">Réparations</NavLink></div>
            <div class="px-3 text-white">@context.User.Identity?.Name</div>
            <div class="p-3"><button class="btn btn-light" @onclick="Deconnexion">Déconnexion</button></div>
        </Authorized>
        <NotAuthorized>
            <div class="nav-item px-3"><NavLink class="nav-link" href="login">Connexion</NavLink></div>
        </NotAuthorized>
    </AuthorizeView>
</nav>

@code {
    private async Task Deconnexion()
    {
        await Auth.DeconnecterAsync();
        Navigation.NavigateTo("");
    }
}
