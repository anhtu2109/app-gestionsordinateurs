{
  "Urls": "http://localhost:5010",
  "ReverseProxy": {
    "Routes": {
      "ordinateurs": {
        "ClusterId": "metier",
        "Match": {
          "Path": "/api/ordinateurs/{**reste}"
        }
      },
      "reparations": {
        "ClusterId": "metier",
        "Match": {
          "Path": "/api/reparations/{**reste}"
        }
      },
      "reparation": {
        "ClusterId": "metier",
        "Match": {
          "Path": "/api/reparation/{**reste}"
        }
      },
      "users": {
        "ClusterId": "metier",
        "Match": {
          "Path": "/api/users/{**reste}"
        }
      },
      "authentication": {
        "ClusterId": "auth",
        "Match": {
          "Path": "/api/authentication/{**reste}"
        }
      }
    },
    "Clusters": {
      "metier": {
        "Destinations": {
          "api": {
            "Address": "http://localhost:5256/"
          }
        }
      },
      "auth": {
        "Destinations": {
          "api": {
            "Address": "http://localhost:5011/"
          }
        }
      }
    }
  }
}
